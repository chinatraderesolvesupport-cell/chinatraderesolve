# ChinaTradeResolve local/Render environment template.
# Never commit real passwords, API keys, private keys or recovery phrases.

# Database: Render must use persistent PostgreSQL via DATABASE_URL. SQLite is local/test only and does not pass /ready.
DATABASE_URL=
DATABASE_PATH=./data/ctr.db

# Required for administrator access. Use different random values, 32+ characters each.
ADMIN_TOKEN=
APP_SECRET=

# Optional custom domain. Leave blank until the domain is connected and opens successfully in Render.
PUBLIC_BASE_URL=
# Enable only after the custom domain works. Redirects the technical Render hostname with HTTP 308.
ENABLE_CANONICAL_REDIRECT=false

# Search indexing is an explicit switch independent of AI/email readiness. Enable only on the final public domain.
SEARCH_INDEXING_ENABLED=false
# Public launch mode is fail-closed. Enable it only after /ready returns 200.
PUBLIC_LAUNCH_MODE=false
FREE_ACCESS_MODE=true
RETENTION_DAYS=90
INACTIVE_RETENTION_DAYS=365
MAINTENANCE_INTERVAL_SECONDS=60
RETENTION_CHECK_INTERVAL_SECONDS=86400

# OpenAI features. Keep the global billing switch false until the API account is funded.
# After payment, set OPENAI_BILLING_READY=true to allow the individually enabled features.
OPENAI_BILLING_READY=false
OPENAI_API_KEY=
OPENAI_MODEL=
ENABLE_AI_TRIAGE=false
APPLICATION_TRIAGE_TIMEOUT_SECONDS=8
ENABLE_AI_ASSISTANT=false
OPENAI_ASSISTANT_MODEL=
AI_ASSISTANT_MAX_OUTPUT_TOKENS=500
AI_ASSISTANT_HISTORY_MESSAGES=8
MAX_DAILY_AI_ASSISTANT_REQUESTS_PER_SESSION=20
MAX_DAILY_AI_ASSISTANT_GLOBAL_REQUESTS=500
ENABLE_VOICE_INPUT=true
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_MAX_SECONDS=120
MAX_DAILY_VOICE_TRANSCRIPTIONS_PER_SESSION=10
MAX_DAILY_VOICE_TRANSCRIPTIONS_GLOBAL=200
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MODERATION_MODEL=omni-moderation-latest
ENABLE_DOCUMENT_ANALYSIS=false
OPENAI_DOCUMENT_MODEL=
DOCUMENT_ANALYSIS_MAX_OUTPUT_TOKENS=6000
DOCUMENT_ANALYSIS_TIMEOUT_SECONDS=90
DOCUMENT_PDF_DETAIL=low
MAX_DAILY_DOCUMENT_ANALYSES_PER_CASE=3
MAX_DAILY_DOCUMENT_ANALYSES_GLOBAL=100

# Optional public-form bot protection. Configure both values or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Real operator identity for the privacy notice and compliance records.
DATA_CONTROLLER_NAME=
DATA_CONTROLLER_ADDRESS=
DATA_CONTROLLER_REGISTRATION=
OPERATOR_CREDENTIALS=

# Contact details.
CONTACT_EMAIL=chinatraderesolve.support@gmail.com
ADMIN_EMAIL=chinatraderesolve.support@gmail.com

# Email delivery is disabled until SMTP_HOST or the bridge settings are filled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ChinaTradeResolve <chinatraderesolve.support@gmail.com>
EMAIL_BRIDGE_URL=
EMAIL_BRIDGE_SECRET=
EMAIL_BRIDGE_TIMEOUT_SECONDS=20

# Optional Telegram monitor. It passively watches only public channels/groups
# accessible to the authorised Telegram account and sends matching links to the owner.
# It never replies to users. Keep API_HASH and SESSION_STRING secret.
TELEGRAM_MONITOR_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Empty = all public channels/groups already available to the account.
# Or specify comma-separated public usernames without @.
TELEGRAM_MONITOR_CHATS=
# Optional comma-separated additional matching phrases and exclusions.
TELEGRAM_MONITOR_KEYWORDS=
TELEGRAM_MONITOR_EXCLUDE_KEYWORDS=
TELEGRAM_MONITOR_STARTUP_NOTICE=false
# Temporary diagnostics. Keep false in normal production.
TELEGRAM_MONITOR_TEST_OWN_MESSAGES=false
TELEGRAM_MONITOR_SELF_TEST_ON_STARTUP=false
TELEGRAM_MONITOR_HEARTBEAT_SECONDS=45
TELEGRAM_MONITOR_MAX_RETRY_SECONDS=120

# Search-engine ownership and analytics. Paste only the verification token, not the full meta tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
YANDEX_METRIKA_ID=
INDEXNOW_KEY=

# Optional values used only by scripts/production_smoke_test.py in Render Shell.
# They are not read by public request handlers.
SMOKE_TEST_BASE_URL=https://chinatraderesolve.com
SMOKE_TEST_EMAIL=

# Voluntary support. The PayPal link is public and contains no secret.
ENABLE_VOLUNTARY_SUPPORT=true
PAYPAL_SUPPORT_URL=https://www.paypal.com/ncp/payment/THKQMZDRRNHQ8
# Optional additional external provider.
SUPPORT_URL=
SUPPORT_PROJECT_NAME=ChinaTradeResolve
BTC_ADDRESS=1KPw94sUBeJH3noxdgQWrVMQf3sAebmeN4
ETH_ADDRESS=0x2F8a2773F8254d061ef286Bac8BF922344a2A494
USDT_TRC20_ADDRESS=TEJaGC38ZV8UirP7zkfPRiqHRi73wTWX5R
SOL_ADDRESS=AEZsJ2921CR7qD7kRQRS7BiaxneeaFyKMhwDmyjCS6Zm

# Set only behind a trusted non-Render reverse proxy. Render sets RENDER=true itself.
TRUST_PROXY_HEADERS=false

# Search engine ownership and fast indexing (optional)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
